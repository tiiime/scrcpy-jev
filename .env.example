# Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Leave empty to use the only connected device; set it when several are attached.
ANDROID_SERIAL=
ADB_HOST=127.0.0.1
ADB_PORT=5037

# The scrcpy release that must be installed locally (its server jar is pushed to the device).
SCRCPY_PATH=scrcpy
SCRCPY_SERVER_PATH=
SCRCPY_VERSION=

# Live view quality. maxSize caps the long edge of the encoded video (0 = native).
SCRCPY_MAX_SIZE=1024
SCRCPY_MAX_FPS=60
SCRCPY_BIT_RATE=6000000

# The studio binds to localhost only.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=3050
# npm run dev opens this URL in your browser. Set to 0 to keep it manual.
STUDIO_OPEN=
